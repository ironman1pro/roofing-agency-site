/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.snitcher.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io https://radar.snitcher.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Caching. Keep these path rules from overlapping: Cloudflare joins the values when
# several rules match one file, which would break Cache-Control.
#
# /assets/ and /portfolio/thumbs/ are cached for a year. Pages link these files with a
# ?v= number, so whenever you change one, bump its ?v= everywhere it's linked
# (e.g. site.css?v=6 -> site.css?v=5). For og.png or adaptify-logo-512.png, use a new file name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/portfolio/thumbs/*
  Cache-Control: public, max-age=31536000, immutable

# Unversioned files: a week, refreshed in the background.
/portfolio/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/portfolio/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
